# Server Configuration
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=50mb

# Google Cloud Vertex AI Configuration (Optional, uses ADC by default)
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_CLOUD_LOCATION=global

# Note: Do NOT put your actual API keys in this file.
# This is just a template. Users should enter their keys in the frontend UI (BYOK),
# or you can copy this to .env.local for local backend-level overrides.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
